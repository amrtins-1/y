---
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <main class="admin-inbox-wrapper admin-command-wrapper">
        <section class="admin-hero admin-command-hero">
            <div class="admin-hero-copy">
                <p class="admin-eyebrow">Operacao administrativa</p>
                <h1>Central de triagem e resposta</h1>
                <p>Monitore contatos, priorize consultorias urgentes e responda cada caso em um fluxo mais claro e isolado.</p>
            </div>
            <div class="admin-hero-panels">
                <article class="admin-hero-card">
                    <span>Fila ativa</span>
                    <strong id="admin-hero-active">0</strong>
                    <small>Itens aguardando decisao</small>
                </article>
                <article class="admin-hero-card admin-hero-card-accent">
                    <span>Casos sensiveis</span>
                    <strong id="admin-hero-urgent">0</strong>
                    <small>Exigem retorno mais rapido</small>
                </article>
            </div>
        </section>

        <section class="admin-stats" id="admin-stats">
            <article class="stat-card">
                <div>
                    <h3 id="admin-stat-contacts">0</h3>
                    <p>Mensagens abertas</p>
                </div>
                <div class="stat-icon-bg"><i class="fas fa-envelope-open-text"></i></div>
            </article>
            <article class="stat-card">
                <div>
                    <h3 id="admin-stat-consultancy">0</h3>
                    <p>Consultorias abertas</p>
                </div>
                <div class="stat-icon-bg"><i class="fas fa-scale-balanced"></i></div>
            </article>
            <article class="stat-card">
                <div>
                    <h3 id="admin-stat-urgent">0</h3>
                    <p>Casos urgentes</p>
                </div>
                <div class="stat-icon-bg"><i class="fas fa-triangle-exclamation"></i></div>
            </article>
            <article class="stat-card">
                <div>
                    <h3 id="admin-stat-awaiting">0</h3>
                    <p>Aguardando resposta</p>
                </div>
                <div class="stat-icon-bg"><i class="fas fa-inbox"></i></div>
            </article>
        </section>

        <section class="admin-toolbar admin-toolbar-polished">
            <div class="admin-filter-group">
                <label for="admin-filter-type">Tipo</label>
                <select id="admin-filter-type">
                    <option value="all">Todos</option>
                    <option value="consultancy">Consultoria</option>
                    <option value="contact">Contato</option>
                </select>
            </div>
            <div class="admin-filter-group">
                <label for="admin-filter-urgency">Urgencia</label>
                <select id="admin-filter-urgency">
                    <option value="all">Todas</option>
                    <option value="critical">Critica</option>
                    <option value="high">Alta</option>
                    <option value="medium">Media</option>
                    <option value="low">Baixa</option>
                </select>
            </div>
            <div class="admin-filter-group admin-search-group">
                <label for="admin-filter-search">Buscar</label>
                <input id="admin-filter-search" type="search" placeholder="Nome, email, assunto ou fazenda">
            </div>
        </section>

        <section class="admin-inbox-grid admin-inbox-grid-upgraded">
            <div class="admin-inbox-list admin-inbox-list-upgraded" id="admin-inbox-list"></div>
            <aside class="admin-detail-panel admin-side-briefing">
                <div class="admin-side-block">
                    <p class="admin-side-kicker">Radar de operacao</p>
                    <h2 id="admin-briefing-title">Selecione um atendimento</h2>
                    <p id="admin-briefing-copy">Ao clicar em um item da fila, uma janela dedicada abre com contexto, resposta e acoes de limpeza.</p>
                </div>

                <div class="admin-side-block admin-side-legend">
                    <h3>Guia de urgencia</h3>
                    <ul>
                        <li><span class="admin-urgency-badge admin-urgency-critical">Critica</span> ataque em andamento ou perda total</li>
                        <li><span class="admin-urgency-badge admin-urgency-high">Alta</span> invasao parcial ou forte escalada</li>
                        <li><span class="admin-urgency-badge admin-urgency-medium">Media</span> ameaca ou necessidade de retorno rapido</li>
                        <li><span class="admin-urgency-badge admin-urgency-low">Baixa</span> contato geral e acompanhamento</li>
                    </ul>
                </div>

                <div class="admin-side-block admin-side-focus" id="admin-focus-card">
                    <p class="admin-side-kicker">Em foco</p>
                    <strong id="admin-focus-name">Nenhum item selecionado</strong>
                    <span id="admin-focus-meta">Escolha uma mensagem na fila para abrir a janela de atendimento.</span>
                </div>
            </aside>
        </section>
    </main>

    <div class="admin-modal-shell" id="admin-modal-shell" hidden aria-hidden="true">
        <div class="admin-modal-backdrop" data-admin-modal-close></div>
        <section class="admin-modal-card" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
            <button type="button" class="admin-modal-close" data-admin-modal-close aria-label="Fechar atendimento">
                <i class="fas fa-xmark"></i>
            </button>
            <div id="admin-detail-content"></div>
        </section>
    </div>
</Layout>

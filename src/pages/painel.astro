---
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <main class="dashboard-sophisticated-wrapper direct-mode">
        <div class="dashboard-inline-header">
            <h1 id="dashboard_heading">Ola, <span id="dashboard_user_name">Membro</span></h1>
            <p id="dashboard_auth_subtitle">Gerencie suas doacoes, servicos e dados pessoais.</p>
        </div>

        <div class="dashboard-grid-sophisticated">
            <a href="/admin" class="dashboard-card-sophisticated" id="admin-dashboard-card" hidden style="display: none;" aria-hidden="true" tabindex="-1">
                <div class="icon-circle-gold">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="card-text">
                    <h3>Administracao</h3>
                    <p>Acesse a caixa de mensagens, consultorias e prioridades do instituto.</p>
                </div>
                <div class="card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/info_user" class="dashboard-card-sophisticated">
                <div class="icon-circle-gold">
                    <i class="fas fa-id-card"></i>
                </div>
                <div class="card-text">
                    <h3 data-i18n="dash_data_title">Meus Dados</h3>
                    <p data-i18n="dash_data_desc">Atualize suas informacoes de contato e senha.</p>
                </div>
                <div class="card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/doacao" class="dashboard-card-sophisticated">
                <div class="icon-circle-gold">
                    <i class="fas fa-hand-holding-heart"></i>
                </div>
                <div class="card-text">
                    <h3 data-i18n="dash_donation_title">Doacoes</h3>
                    <p data-i18n="dash_donation_desc">Visualize seu historico de contribuicoes e recibos.</p>
                </div>
                <div class="card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/servicos" class="dashboard-card-sophisticated">
                <div class="icon-circle-gold">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div class="card-text">
                    <h3 data-i18n="dash_services_title">Servicos</h3>
                    <p data-i18n="dash_services_desc">Acompanhe o status das suas solicitacoes de consultoria.</p>
                </div>
                <div class="card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/" class="dashboard-card-sophisticated logout-card">
                <div class="icon-circle-red">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <div class="card-text">
                    <h3 data-i18n="dash_logout">Sair</h3>
                    <p data-i18n="dash_logout_desc">Encerrar a sessao de forma segura.</p>
                </div>
                <div class="card-arrow red">
                    <i class="fas fa-power-off"></i>
                </div>
            </a>
        </div>
    </main>
</Layout>

function buildBoiCards(rows: Row[]): CardTable[] {
  const byItem = new Map<string, Row[]>();
  for (const row of rows) {
    const bucket = byItem.get(row.itemKey) ?? [];
    bucket.push(row);
    byItem.set(row.itemKey, bucket);
  }

  const indicadores = byItem.get("") ?? [];
  const contratoRows: Array<{ busca: string; cells: string[]; status?: Status }> = [];
  const fisicoRows: Array<{ busca: string; cells: string[]; status?: Status }> = [];
  const reposicaoRows: Array<{ busca: string; cells: string[]; status?: Status }> = [];
  const genericCards: CardTable[] = [];

  for (const [itemKey, itemRows] of byItem.entries()) {
    if (!itemRows.length || itemKey === "") continue;
    const keys = new Set(itemRows.map((r) => r.colunaKey));
    const get = (key: string) => itemRows.find((r) => r.colunaKey === key);

    if (keys.has("fechamento_r") || keys.has("variacao")) {
      const fechamento = get("fechamento_r")?.valorFmt ?? "-";
      const variacao = get("variacao")?.valorFmt ?? get("var")?.valorFmt ?? "-";
      contratoRows.push({
        busca: slugText([itemKey, fechamento, variacao].join(" ")),
        cells: [boiDisplayName(itemKey), fechamento, variacao],
        status: get("variacao")?.status ?? get("var")?.status,
      });
      continue;
    }

    if (keys.has("boi_gordo_r_a_vista") || keys.has("boi_gordo_r_prazo_30_dias")) {
      const spot = get("boi_gordo_r_a_vista")?.valorFmt ?? "-";
      const prazo = get("boi_gordo_r_prazo_30_dias")?.valorFmt ?? "-";
      const vaca = get("vaca_gorda_r_a_vista")?.valorFmt ?? "-";
      const label = itemRows[0]?.label || boiDisplayName(itemKey);
      fisicoRows.push({
        busca: slugText([label, spot, prazo, vaca].join(" ")),
        cells: [label, spot, prazo, vaca],
      });
      continue;
    }

    if (keys.has("r_cabeca") || keys.has("r_kg") || keys.has("troca")) {
      const cabeca = get("r_cabeca")?.valorFmt ?? "-";
      const kg = get("r_kg")?.valorFmt ?? "-";
      const troca = get("troca")?.valorFmt ?? "-";
      const estado = itemRows[0]?.label || boiDisplayName(itemKey);
      reposicaoRows.push({
        busca: slugText([estado, cabeca, kg, troca].join(" ")),
        cells: [estado, cabeca, kg, troca],
      });
      continue;
    }

    genericCards.push({
      id: `boi-generic-${itemKey}`,
      title: boiDisplayName(itemKey),
      subtitle: "Fonte de Mercado",
      columns: ["Referência", "Valor", "Status"],
      rows: itemRows.map((row) => ({
        busca: row.busca,
        cells: [row.referencia, row.valorFmt, statusLabel(row.status)],
        status: row.status,
      })),
    });
  }

  const cards: CardTable[] = [];
  if (indicadores.length) {
    const get = (key: string) => indicadores.find((r) => r.colunaKey === key);
    const dataRef = indicadores[0]?.label || "-";
    cards.push({
      id: "boi-indicadores",
      title: "Indicadores do Boi Gordo",
      subtitle: "ESALQ / B3",
      columns: ["Data", "À Vista (R$)", "A Prazo (R$)", "Variação (%)"],
      rows: [
        {
          busca: slugText(
            [dataRef, get("a_vista_r")?.valorFmt, get("a_prazo_r")?.valorFmt, get("variacao")?.valorFmt].join(" ")
          ),
          cells: [dataRef, get("a_vista_r")?.valorFmt ?? "-", get("a_prazo_r")?.valorFmt ?? "-", get("variacao")?.valorFmt ?? "-"],
          status: get("variacao")?.status,
        },
      ],
    });
  }

  if (contratoRows.length) {
    cards.push({
      id: "boi-b3",
      title: "Boi Gordo - B3 (Pregão Regular)",
      subtitle: "Contratos por Vencimento",
      columns: ["Contrato - Mês", "Fechamento (R$/@)", "Variação (%)"],
      rows: contratoRows,
    });
  }

  if (fisicoRows.length) {
    cards.push({
      id: "boi-fisico",
      title: "Boi Gordo - Mercado Físico",
      subtitle: "Preços por Praça",
      columns: ["Praça", "À Vista (R$)", "A Prazo (R$)", "Vaca Gorda (R$)"],
      rows: fisicoRows,
    });
  }

  if (reposicaoRows.length) {
    cards.push({
      id: "boi-reposicao",
      title: "Reposição - Macho Nelore",
      subtitle: "R$/Cabeça, R$/Kg e Troca",
      columns: ["Estado / Praça", "R$/Cabeça", "R$/Kg", "Troca"],
      rows: reposicaoRows,
    });
  }

  return [...cards, ...genericCards];
}

const boiCards = buildBoiCards(datasetPorCategoria.boi ?? []);
const cardsPorCategoria: Record<string, CardTable[]> = Object.fromEntries(
  categoriasOrdenadas.map((prefix) => [
    prefix,
    prefix === "boi"
      ? boiCards
      : prefix === "soja" ||
          prefix === "milho" ||
          prefix === "arroz" ||
          prefix === "cafe" ||
          prefix === "acucar_etanol" ||
          prefix === "algodao" ||
          prefix === "trigo" ||
          prefix === "feijao" ||
          prefix === "suinos" ||
          prefix === "frango" ||
          prefix === "ovos" ||
          prefix === "leite" ||
          prefix === "laranja" ||
          prefix === "mandioca" ||
          prefix === "amendoim" ||
          prefix === "cacau" ||
          prefix === "sorgo"
        ? buildFocusedCards(prefix, datasetPorCategoria[prefix] ?? [])
        : buildGenericCards(prefix, datasetPorCategoria[prefix] ?? []),
  ])
);

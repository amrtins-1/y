---
import Layout from "../layouts/Layout.astro";
import CotacoesLayout from "../layouts/CotacoesLayout.astro";
import { DADOS_MERCADO } from "../data/cotacoes.js";
import HISTORICO from "../data/historico.json";
import CotacoesBackground from '../assets/img/cotacoesimg.jpg';

type Status = "up" | "down" | "equal" | "unknown";
type DadoCotacao = {
  valor?: string;
  status?: string;
  label?: string;
};
type ItemCotacao = Record<string, DadoCotacao>;
type SecaoCotacao = Record<string, ItemCotacao>;
type CategoriaCotacao = Record<string, SecaoCotacao>;
type RaiasCotacao = Record<string, CategoriaCotacao>;
type CardTable = {
  id: string;
  title: string;
  subtitle: string;
  columns: string[];
  rows: Array<{ busca: string; cells: string[]; status?: Status }>;
};
type Row = {
  id: string;
  categoria: string;
  secao: string;
  secaoKey: string;
  itemKey: string;
  colunaKey: string;
  label: string;
  referencia: string;
  valorRaw: string;
  valorFmt: string;
  status: Status;
  busca: string;
};
type TickerMovement = {
  id: string;
  categoria: string;
  label: string;
  valueNow: number;
  valuePrev: number;
  deltaAbs: number;
  deltaPct: number;
  direction: "up" | "down";
};

const { atualizacao } = DADOS_MERCADO;
const raias = DADOS_MERCADO.raias as RaiasCotacao;

const categoryMap: Record<string, string> = {
  boi: "Pecuária de Corte",
  soja: "Complexo Soja",
  milho: "Milho",
  cafe: "Café",
  arroz: "Arroz",
  algodao: "Algodão",
  trigo: "Trigo",
  feijao: "Feijão",
  suinos: "Suinocultura",
  frango: "Avicultura",
  ovos: "Postura",
  acucar_etanol: "Cana/Açúcar/Etanol",
  leite: "Leite e Laticínios",
  laranja: "Citricultura",
  mandioca: "Mandioca",
  dolar: "Câmbio e Macro",
  amendoim: "Amendoim",
  cacau: "Cacau",
  sorgo: "Sorgo",
};

const ordemCategorias = ["boi", "soja", "milho", "cafe", "dolar", "acucar_etanol"];
const categoriasDisponiveis = Object.keys(raias ?? {});
const categoriasOrdenadas = [
  ...ordemCategorias.filter((c) => categoriasDisponiveis.includes(c)),
  ...categoriasDisponiveis.filter((c) => !ordemCategorias.includes(c)),
];

const commodityMatchers: Record<string, RegExp[]> = {
  boi: [/\bboi\b/, /\bvaca\b/, /\bbezerro\b/, /\barroba\b/, /\bpecuar/],
  cafe: [/\bcafe\b/, /\bicafe\b/],
  soja: [/\bsoja\b/, /\bfarelo\b/, /\boleo\b.*\bsoja\b/],
  milho: [/\bmilho\b/],
  algodao: [/\balgodao\b/],
  acucar_etanol: [/\bacucar\b/, /\betanol\b/, /\bcana\b/],
  laranja: [/\blaranja\b/, /\bsuco\b.*\blar/],
  cacau: [/\bcacau\b/],
  sorgo: [/\bsorgo\b/],
  leite: [/\bleite\b/, /\blact/],
  suinos: [/\bsuino\b/, /\bporco\b/],
  frango: [/\bfrango\b/, /\bave\b/],
  ovos: [/\bovo\b/],
  arroz: [/\barroz\b/],
  feijao: [/\bfeijao\b/],
  trigo: [/\btrigo\b/],
  amendoim: [/\bamendoim\b/],
  mandioca: [/\bmandioca\b/],
  dolar: [/\bdolar\b/, /\bcambio\b/, /\busd\b/, /\breal\b/],
};

function slugText(text = ""): string {
  return String(text)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]/g, "_")
    .replace(/_+/g, "_")
    .replace(/^_+|_+$/g, "");
}

function prettyKey(value = ""): string {
  const text = value.replace(/^_+|_+$/g, "").replace(/_/g, " ").trim();
  if (!text) return "-";
  return text.replace(/\s+/g, " ");
}

function resolveCardIcon(prefix: string, title = "", subtitle = ""): string {
  const content = `${title} ${subtitle}`.toLowerCase();

  if (/\bboi\b|\bvaca\b|\bbezerro\b|\barroba\b/.test(content)) return "fa-cow";
  if (/\bsuino\b|\bporco\b/.test(content)) return "fa-bacon";
  if (/\bfrango\b|\bave\b/.test(content)) return "fa-drumstick-bite";
  if (/\bovo\b/.test(content)) return "fa-egg";
  if (/\bcafe\b/.test(content)) return "fa-mug-hot";
  if (/\bsoja\b|\bfarelo\b|\boleo\b/.test(content)) return "fa-seedling";
  if (/\bmilho\b|\bsorgo\b/.test(content)) return "fa-wheat-awn";
  if (/\barroz\b|\btrigo\b|\bfeijao\b/.test(content)) return "fa-wheat-awn";
  if (/\bacucar\b|\betanol\b|\bcana\b/.test(content)) return "fa-industry";
  if (/\bleite\b|\blactic/.test(content)) return "fa-glass-water";
  if (/\blaranja\b|\bcitr/.test(content)) return "fa-lemon";
  if (/\bmandioca\b/.test(content)) return "fa-seedling";
  if (/\bdolar\b|\bcambio\b|\busd\b|\bmacro\b/.test(content)) return "fa-dollar-sign";

  const byCategory: Record<string, string> = {
    boi: "fa-cow",
    soja: "fa-seedling",
    milho: "fa-wheat-awn",
    cafe: "fa-mug-hot",
    arroz: "fa-wheat-awn",
    algodao: "fa-seedling",
    trigo: "fa-wheat-awn",
    feijao: "fa-seedling",
    suinos: "fa-bacon",
    frango: "fa-drumstick-bite",
    ovos: "fa-egg",
    acucar_etanol: "fa-industry",
    leite: "fa-glass-water",
    laranja: "fa-lemon",
    mandioca: "fa-seedling",
    dolar: "fa-dollar-sign",
    amendoim: "fa-seedling",
    cacau: "fa-seedling",
    sorgo: "fa-wheat-awn",
  };

  return byCategory[prefix] || "fa-chart-column";
}

function normalizeDisplayText(value = ""): string {
  let text = String(value || "").replace(/\s+/g, " ").trim();
  if (!text || text === "-") return text || "-";

  const direct: Array<[RegExp, string]> = [
    [/\bprecos\b/gi, "Preços"],
    [/\bpreco\b/gi, "Preço"],
    [/\bvariacao\b/gi, "Variação"],
    [/\breferencia\b/gi, "Referência"],
    [/\breferencias\b/gi, "Referências"],
    [/\bfisico\b/gi, "Físico"],
    [/\breposicao\b/gi, "Reposição"],
    [/\bdesmama\b/gi, "Desmama"],
    [/\bacucar\b/gi, "Açúcar"],
    [/\balgodao\b/gi, "Algodão"],
    [/\bcafe\b/gi, "Café"],
    [/\bfeijao\b/gi, "Feijão"],
    [/\bsuinos\b/gi, "Suínos"],
    [/\bboi\b/gi, "Boi"],
    [/\bvaca\b/gi, "Vaca"],
    [/\bcabeca\b/gi, "Cabeça"],
    [/\bpraca\b/gi, "Praça"],
    [/\bpracas\b/gi, "Praças"],
    [/\bcepea\b/gi, "CEPEA"],
    [/\besalq\b/gi, "ESALQ"],
    [/\bnybot\b/gi, "NYBOT"],
    [/\bcme\b/gi, "CME"],
    [/\bb3\b/gi, "B3"],
    [/\bice\b/gi, "ICE"],
    [/\brkgton\b/gi, "R$/Kg/Ton"],
    [/\brkg\b/gi, "R$/Kg"],
    [/\brlitro\b/gi, "R$/Litro"],
    [/\brsc\b/gi, "R$/Sc"],
    [/\br30 dz\b/gi, "R$/30 Dz"],
  ];
  direct.forEach(([pattern, replacement]) => {
    text = text.replace(pattern, replacement);
  });

  text = text
    .split(/(\s+|\/|-|\(|\)|,)/)
    .map((chunk) => {
      if (!chunk || /^(\s+|\/|-|\(|\)|,)$/.test(chunk)) return chunk;
      if (/[A-Z0-9$@%]/.test(chunk) || chunk.includes("R$/")) return chunk;
      return chunk.charAt(0).toUpperCase() + chunk.slice(1).toLowerCase();
    })
    .join("");

  return text;
}

function normalizeStatus(status?: string): Status {
  if (status === "up" || status === "down" || status === "equal") return status;
  return "unknown";
}

function parseLocaleNumber(input?: string): number | null {
  if (!input) return null;
  const clean = String(input).trim().replace(/\./g, "").replace(",", ".");
  const num = Number(clean);
  return Number.isFinite(num) ? num : null;
}

function formatValor(raw: string, colunaKey: string): string {
  const num = parseLocaleNumber(raw);
  if (num === null) return raw || "-";
  const isVariacao = /variacao|var\b|percent|pct|%/i.test(colunaKey);
  const base = new Intl.NumberFormat("pt-BR", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(num);
  if (isVariacao) {
    const sign = num > 0 ? "+" : "";
    return `${sign}${base}%`;
  }
  return base;
}

function detectTags(searchText: string): Set<string> {
  const tags = new Set<string>();
  const normalized = slugText(searchText);
  for (const [categoria, regexes] of Object.entries(commodityMatchers)) {
    if (regexes.some((re) => re.test(normalized))) tags.add(categoria);
  }
  return tags;
}

function buildRows(prefix: string): Row[] {
  const categoria = raias[prefix];
  if (!categoria || typeof categoria !== "object") return [];

  const rows: Row[] = [];
  for (const [secao, itens] of Object.entries(categoria)) {
    if (!itens || typeof itens !== "object") continue;
    for (const [itemKey, colunas] of Object.entries(itens as Record<string, unknown>)) {
      if (!colunas || typeof colunas !== "object") continue;
      for (const [colunaKey, dados] of Object.entries(colunas as Record<string, any>)) {
        if (!dados || typeof dados !== "object") continue;
        const valorRaw = String(dados.valor ?? "").trim();
        const label = String(dados.label ?? "").trim();
        if (!valorRaw && !label) continue;
        const referencia = normalizeDisplayText(prettyKey(colunaKey));
        const row: Row = {
          id: `${prefix}__${secao}__${itemKey}__${colunaKey}`,
          categoria: prefix,
          secao: normalizeDisplayText(prettyKey(secao)),
          secaoKey: secao,
          itemKey,
          colunaKey,
          label: normalizeDisplayText(label || prettyKey(itemKey)),
          referencia,
          valorRaw,
          valorFmt: formatValor(valorRaw, colunaKey),
          status: normalizeStatus(dados.status),
          busca: slugText([label, secao, itemKey, colunaKey, valorRaw].join(" ")),
        };
        rows.push(row);
      }
    }
  }

  return rows;
}

function rowsByCategoria(prefix: string): Row[] {
  const rows = buildRows(prefix);
  return rows.filter((row) => {
    const tags = detectTags([row.label, row.referencia, row.itemKey].join(" "));
    if (tags.size === 0) return true;
    return tags.has(prefix);
  });
}

const datasetPorCategoria: Record<string, Row[]> = Object.fromEntries(
  categoriasOrdenadas.map((prefix) => [prefix, rowsByCategoria(prefix)])
);

const historicoMap = HISTORICO as Record<string, string>;

function historyKeysForRow(row: Row): string[] {
  const base = `${row.categoria}_${row.secaoKey}`;
  if (!row.itemKey) return [`${base}__${row.colunaKey}`, `${base}_${row.colunaKey}`];
  return [`${base}_${row.itemKey}_${row.colunaKey}`];
}

function isEligibleTickerColumn(colunaKey: string): boolean {
  return !/^(variacao|var|variacaomes|variacaosemana|variacaopontos|variacao_dia|variacao_diaria|vardia)$/i.test(colunaKey);
}

function toTickerMovement(row: Row): TickerMovement | null {
  if (!isEligibleTickerColumn(row.colunaKey)) return null;
  const valueNow = parseLocaleNumber(row.valorRaw);
  if (valueNow === null) return null;
  const prevKey = historyKeysForRow(row).find((k) => k in historicoMap);
  if (!prevKey) return null;
  const valuePrev = parseLocaleNumber(historicoMap[prevKey]);
  if (valuePrev === null || valuePrev === 0 || valueNow === valuePrev) return null;
  const deltaAbs = valueNow - valuePrev;
  const deltaPct = (deltaAbs / Math.abs(valuePrev)) * 100;
  return {
    id: row.id,
    categoria: row.categoria,
    label: row.label,
    valueNow,
    valuePrev,
    deltaAbs,
    deltaPct,
    direction: deltaAbs > 0 ? "up" : "down",
  };
}

function buildTickerMovements(): TickerMovement[] {
  const allRows = Object.values(datasetPorCategoria).flat();
  const movements = allRows
    .map(toTickerMovement)
    .filter((item): item is TickerMovement => Boolean(item));

  const byId = new Map<string, TickerMovement>();
  for (const m of movements) {
    const prev = byId.get(m.id);
    if (!prev || Math.abs(m.deltaPct) > Math.abs(prev.deltaPct)) byId.set(m.id, m);
  }

  const deduped = Array.from(byId.values());
  let ups = deduped.filter((m) => m.direction === "up").sort((a, b) => b.deltaPct - a.deltaPct).slice(0, 20);
  let downs = deduped.filter((m) => m.direction === "down").sort((a, b) => a.deltaPct - b.deltaPct).slice(0, 20);

  if (ups.length < 20 || downs.length < 20) {
    const fallback = allRows
      .filter((row) => /^(variacao|var|variacaomes|variacaosemana|variacaopontos|variacao_dia|variacao_diaria|vardia)$/i.test(row.colunaKey))
      .map((row): TickerMovement | null => {
        const pct = parseLocaleNumber(row.valorRaw);
        if (pct === null || pct === 0) return null;
        return {
          id: `${row.id}__fallback`,
          categoria: row.categoria,
          label: row.label,
          valueNow: pct,
          valuePrev: 0,
          deltaAbs: pct,
          deltaPct: pct,
          direction: pct > 0 ? "up" : "down",
        };
      })
      .filter((item): item is TickerMovement => Boolean(item));

    const fallbackUps = fallback.filter((m) => m.direction === "up").sort((a, b) => b.deltaPct - a.deltaPct);
    const fallbackDowns = fallback.filter((m) => m.direction === "down").sort((a, b) => a.deltaPct - b.deltaPct);

    if (ups.length < 20) ups = [...ups, ...fallbackUps.slice(0, 20 - ups.length)];
    if (downs.length < 20) downs = [...downs, ...fallbackDowns.slice(0, 20 - downs.length)];
  }

  const alternated: TickerMovement[] = [];
  const maxLen = Math.max(ups.length, downs.length);
  for (let i = 0; i < maxLen; i++) {
    if (ups[i]) alternated.push(ups[i]);
    if (downs[i]) alternated.push(downs[i]);
  }
  return alternated;
}

const tickerItems = buildTickerMovements();

function formatSignedPercent(value: number): string {
  const sign = value > 0 ? "+" : "";
  return `${sign}${new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value)}%`;
}

function statusLabel(status: Status): string {
  if (status === "up") return "Alta";
  if (status === "down") return "Queda";
  if (status === "equal") return "Estável";
  return "Sem Sinal";
}

function boiDisplayName(rawItemKey: string): string {
  const text = prettyKey(rawItemKey);
  if (/^\d/.test(text)) return text;
  return normalizeDisplayText(
    text
    .replace(/([a-zA-Z])(\d)/g, "$1 $2")
    .replace(/(\d)([a-zA-Z])/g, "$1 $2")
    .replace(/\b(\w)/g, (m) => m.toUpperCase())
  );
}

function columnTitle(colunaKey: string): string {
  const map: Record<string, string> = {
    preco: "Preço",
    preco_r: "Preço (R$)",
    preco_rsc_de_60_kg: "Preço (R$/Sc 60Kg)",
    preco_rsc_60_kg: "Preço (R$/Sc 60Kg)",
    preco_rsc_50_kg: "Preço (R$/Sc 50Kg)",
    preco_r_kg: "Preço (R$/Kg)",
    preco_rkg: "Preço (R$/Kg)",
    preco_rlitro: "Preço (R$/Litro)",
    preco_r30_dz: "Preço (R$/30 Dz)",
    preco_r_caixa_de_30_duzias: "Preço (R$/Cx 30 Dz)",
    preco_rtonelada: "Preço (R$/Ton)",
    valor_r: "Valor (R$)",
    valor_rsc_60_kg: "Valor (R$/Sc 60Kg)",
    valor_r_saca_de_60_kg: "Valor (R$/Sc 60Kg)",
    valor_r_saca_de_50_kg: "Valor (R$/Sc 50Kg)",
    fechamento_r: "Fechamento (R$)",
    fechamento_rsc_60_kg: "Fechamento (R$/Sc 60Kg)",
    fechamento_ussc_60_kg: "Fechamento (US$/Sc 60Kg)",
    fechamento_us_bushel: "Fechamento (US$/Bu)",
    fechamento_uston: "Fechamento (US$/Ton)",
    fechamento_us_ton: "Fechamento (US$/Ton)",
    fech_investing_lb: "Fech. Investing (c/lb)",
    usbu: "US$/Bu",
    ustonelada_curta: "US$/Ton Curta",
    centslb: "cents/lb",
    variacao: "Variação (%)",
    var: "Variação (%)",
    variacao_centsbu: "Variação (cents/bu)",
    variacao_centslb: "Variação (cents/lb)",
    variacao_centston: "Variação (cents/ton)",
    variacao_pontos: "Variação (Pontos)",
    variacaosemana: "Variação Semanal (%)",
    variacao_dia: "Variação Diária (%)",
    rkg: "R$/Kg",
    rlitro: "R$/Litro",
    rsc: "R$/Sc",
    rt: "R$/Ton",
    r30_dz: "R$/30 Dz",
    r_caixa_408_kg: "R$/Cx 40,8Kg",
    r_a_prazocaixa_408_kg: "R$ a Prazo/Cx 40,8Kg",
  };
  return map[colunaKey] ?? normalizeDisplayText(prettyKey(colunaKey));
}

function columnRank(colunaKey: string): number {
  const rank: Record<string, number> = {
    preco: 10,
    preco_r: 11,
    preco_rsc_de_60_kg: 12,
    preco_rsc_60_kg: 13,
    preco_rsc_50_kg: 14,
    preco_r_kg: 15,
    preco_rkg: 16,
    preco_rlitro: 17,
    preco_r30_dz: 18,
    preco_r_caixa_de_30_duzias: 19,
    preco_rtonelada: 20,
    valor_r: 20,
    valor_rsc_60_kg: 21,
    valor_r_saca_de_60_kg: 22,
    valor_r_saca_de_50_kg: 23,
    fechamento_r: 30,
    fechamento_rsc_60_kg: 31,
    fechamento_ussc_60_kg: 32,
    fechamento_us_bushel: 33,
    fechamento_uston: 34,
    fechamento_us_ton: 35,
    fech_investing_lb: 36,
    usbu: 40,
    ustonelada_curta: 41,
    centslb: 42,
    variacao: 90,
    var: 91,
    variacao_centsbu: 92,
    variacao_centslb: 93,
    variacao_centston: 94,
    variacao_pontos: 95,
    variacaosemana: 96,
    variacao_dia: 97,
  };
  return rank[colunaKey] ?? 50;
}

function isContractItemKey(itemKey: string): boolean {
  const normalized = slugText(itemKey);
  if (!normalized) return false;
  return (
    /(jan|fev|mar|abr|mai|jun|jul|ago|set|out|nov|dez)/.test(normalized) &&
    /\d{2,4}/.test(normalized)
  );
}

function buildCardFromRows(prefix: string, id: string, title: string, subtitle: string, itemGroups: Row[][]): CardTable | null {
  const flat = itemGroups.flat();
  if (!flat.length) return null;
  const colunas = Array.from(new Set(flat.map((r) => r.colunaKey))).sort((a, b) => {
    const d = columnRank(a) - columnRank(b);
    return d !== 0 ? d : columnTitle(a).localeCompare(columnTitle(b), "pt-BR");
  });
  return {
    id: `${prefix}-${id}`,
    title,
    subtitle,
    columns: ["Ativo / Praça", ...colunas.map(columnTitle)],
    rows: itemGroups.map((itemRows) => {
      const label = normalizeDisplayText(itemRows[0]?.label || boiDisplayName(itemRows[0]?.itemKey || ""));
      const cells = [label, ...colunas.map((key) => itemRows.find((r) => r.colunaKey === key)?.valorFmt ?? "-")];
      const status =
        itemRows.find((r) => r.colunaKey === "variacao")?.status ??
        itemRows.find((r) => r.colunaKey === "var")?.status ??
        itemRows.find((r) => r.status !== "unknown")?.status;
      return { busca: slugText([label, itemRows[0]?.itemKey || "", ...cells].join(" ")), cells, status };
    }),
  };
}

function buildGenericCards(prefix: string, rows: Row[]): CardTable[] {
  const bySecao = new Map<string, Row[]>();
  for (const row of rows) {
    const bucket = bySecao.get(row.secao) ?? [];
    bucket.push(row);
    bySecao.set(row.secao, bucket);
  }
  const cards: CardTable[] = [];
  for (const [secao, secaoRows] of bySecao.entries()) {
    const byItem = new Map<string, Row[]>();
    for (const row of secaoRows) {
      const bucket = byItem.get(row.itemKey) ?? [];
      bucket.push(row);
      byItem.set(row.itemKey, bucket);
    }
    const card = buildCardFromRows(
      prefix,
      slugText(secao).replace(/\s+/g, "-"),
      normalizeDisplayText(prettyKey(secao)),
      categoryMap[prefix] || prefix.toUpperCase(),
      Array.from(byItem.values())
    );
    if (card) cards.push(card);
  }
  return cards;
}

function buildFocusedCards(
  prefix:
    | "soja"
    | "milho"
    | "arroz"
    | "cafe"
    | "acucar_etanol"
    | "algodao"
    | "trigo"
    | "feijao"
    | "suinos"
    | "frango"
    | "ovos"
    | "leite"
    | "laranja"
    | "mandioca"
    | "amendoim"
    | "cacau"
    | "sorgo",
  rows: Row[]
): CardTable[] {
  const byItem = new Map<string, Row[]>();
  for (const row of rows) {
    const bucket = byItem.get(row.itemKey) ?? [];
    bucket.push(row);
    byItem.set(row.itemKey, bucket);
  }

  const buckets: Record<"indicador" | "b3" | "internacional" | "fisico" | "derivados" | "outros", Row[][]> = {
    indicador: [],
    b3: [],
    internacional: [],
    fisico: [],
    derivados: [],
    outros: [],
  };

  for (const [itemKey, itemRows] of byItem.entries()) {
    const keys = new Set(itemRows.map((r) => r.colunaKey));
    const text = slugText([itemKey, ...itemRows.map((r) => r.label), ...itemRows.map((r) => r.colunaKey)].join(" "));
    const hasUS = [...keys].some((k) => /us|cents|lb|ton|bu/.test(k));
    const hasB3 = [...keys].some((k) => /fechamento_rsc|fechamento_ussc/.test(k));
    const hasFisico = [...keys].some((k) => /preco_rsc|valor_r_saca|preco_r|preco$/.test(k));
    const indicador = itemKey === "" || /indicador|cepea|esalq/.test(text);
    const derivado = /farelo|oleo|premio|tipo|beneficiado|agulhinha/.test(text);

    if (indicador) buckets.indicador.push(itemRows);
    else if ((hasB3 && isContractItemKey(itemKey)) || /b3|pregao|bmf/.test(text)) buckets.b3.push(itemRows);
    else if (hasUS || /chicago|cme|ny|nybot|londres|liffe|investing|ice/.test(text)) buckets.internacional.push(itemRows);
    else if ((prefix === "soja" || prefix === "arroz" || prefix === "feijao") && derivado) buckets.derivados.push(itemRows);
    else if (
      prefix === "acucar_etanol" &&
      /acucar|etanol|cana|usina|campo|esteira|referencia|litro|m3/.test(text)
    )
      buckets.derivados.push(itemRows);
    else if (
      hasFisico ||
      /mercado|praca|municipio|cooper|sindicato|estado|tipo|granja|atacado|ceasa|ceagesp|media|brasil/.test(text)
    )
      buckets.fisico.push(itemRows);
    else buckets.outros.push(itemRows);
  }


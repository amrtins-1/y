    return out;
  }

  function captureRawSources() {
    document.querySelectorAll<HTMLElement>("[data-i18n^='quote_']").forEach((el) => {
      if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") {
        if (!el.hasAttribute("data-raw-placeholder")) {
          el.setAttribute("data-raw-placeholder", (el.getAttribute("placeholder") || "").trim());
        }
      } else if (!el.hasAttribute("data-raw-text")) {
        el.setAttribute("data-raw-text", (el.textContent || "").trim());
      }
    });

    document.querySelectorAll<HTMLElement>(".item-name [data-i18n^='quote_label_'], .market-tick-name[data-i18n^='quote_label_']").forEach((el) => {
      if (!el.hasAttribute("data-raw-label")) el.setAttribute("data-raw-label", (el.textContent || "").trim());
    });
    document.querySelectorAll<HTMLTableCellElement>("tbody td:not(.item-name)").forEach((td) => {
      if (!td.hasAttribute("data-raw-value")) td.setAttribute("data-raw-value", (td.textContent || "").trim());
    });
    document.querySelectorAll<HTMLElement>(".update-date-js").forEach((el) => {
      if (!el.hasAttribute("data-raw-date")) el.setAttribute("data-raw-date", (el.textContent || "").trim());
    });
  }

  function applyCotacoesLocalization(lang: string) {
    captureRawSources();

    document.querySelectorAll<HTMLElement>("[data-i18n^='quote_']").forEach((el) => {
      const key = el.getAttribute("data-i18n") || "";
      if (!key || hasTranslationForKey(key, lang)) return;
      if (el.classList.contains("update-date-js")) return;
      if (el.closest("tbody td:not(.item-name)")) return;

      if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") {
        const raw = el.getAttribute("data-raw-placeholder") || el.getAttribute("placeholder") || "";
        (el as HTMLInputElement).placeholder = localizeFreeText(translateMonthTokens(raw, lang), lang);
      } else {
        const raw = el.getAttribute("data-raw-text") || el.textContent || "";
        el.textContent = localizeFreeText(translateMonthTokens(raw, lang), lang);
      }
    });

    document.querySelectorAll<HTMLElement>(".item-name [data-i18n^='quote_label_'], .market-tick-name[data-i18n^='quote_label_']").forEach((el) => {
      const key = el.getAttribute("data-i18n") || "";
      if (hasTranslationForKey(key, lang)) return;
      const raw = el.getAttribute("data-raw-label") || el.textContent || "";
      el.textContent = localizeFreeText(translateMonthTokens(raw, lang), lang);
    });

    document.querySelectorAll<HTMLTableCellElement>("tbody td:not(.item-name)").forEach((td) => {
      if (td.querySelector(".update-date-js")) return;
      const raw = td.getAttribute("data-raw-value") || td.textContent || "";
      const normalized = formatNumericByLang(raw, lang);
      td.textContent = localizeFreeText(normalized, lang);
    });

    document.querySelectorAll<HTMLElement>(".update-date-js").forEach((el) => {
      const raw = el.getAttribute("data-raw-date") || el.textContent || "";
      el.textContent = formatDateByLang(raw, lang);
    });

    // Reforço apenas em elementos textuais com chave i18n.
    // Não inclui .boi-card-foot para preservar os spans (rótulo + data) separados.
    document.querySelectorAll<HTMLElement>(".boi-card-head h3[data-i18n], .boi-card-head p[data-i18n], .panel-header p[data-i18n], th[data-i18n], .update-label[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n") || "";
      if (key && hasTranslationForKey(key, lang)) return;
      el.textContent = localizeFreeText(translateMonthTokens(el.textContent || "", lang), lang);
    });
  }

  function initCotacoes() {
    if (cotacoesInitialized) {
      applyCotacoesLocalization(getCurrentLang());
      return;
    }
    cotacoesInitialized = true;

    const buttons = document.querySelectorAll<HTMLButtonElement>(".asset-btn");
    const panels = document.querySelectorAll<HTMLElement>(".quote-panel");
    const search = document.querySelector<HTMLInputElement>("#marketSearch");

    const runSearch = () => {
      const term = String(search?.value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
      const activePanel = document.querySelector<HTMLElement>(".quote-panel.active");
      if (!activePanel) return;
      const rows = activePanel.querySelectorAll<HTMLTableRowElement>("tbody tr");
      rows.forEach((row) => {
        const hay = String(row.getAttribute("data-busca") || "");
        row.classList.toggle("hidden-row", term.length > 0 && !hay.includes(term));
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const ativo = btn.dataset.ativo;
        buttons.forEach((b) => b.classList.remove("active"));
        panels.forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        const targetPanel = document.querySelector<HTMLElement>(`.quote-panel[data-ativo="${ativo}"]`);
        if (targetPanel) targetPanel.classList.add("active");
        runSearch();
      });
    });

    search?.addEventListener("input", runSearch);
    captureRawSources();

    // Conecta com o sistema global de tradução após o carregamento
    if (typeof (window as any).setLanguage === 'function') {
      const savedLang = localStorage.getItem('preferredLang') || 'pt';
      (window as any).setLanguage(savedLang);
    }

    applyCotacoesLocalization(localStorage.getItem("preferredLang") || getCurrentLang());
    document.addEventListener("language:changed", (evt: any) => {
      const lang = evt?.detail?.lang || getCurrentLang();
      applyCotacoesLocalization(lang);
    });

    runSearch();
  }

  document.addEventListener("astro:page-load", initCotacoes);
  initCotacoes();
</script>

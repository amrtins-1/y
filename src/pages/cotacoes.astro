<CotacoesLayout title="Terminal de Cotações">
  <section class="page-header cotacoes-header" style={`--cotacoes-bg: url(${CotacoesBackground.src})`}>
    <h1 data-i18n="quote_page_title">Terminal de Mercado</h1>
    <p data-i18n="quote_page_subtitle">Dados organizados por cadeia produtiva, com filtros de consistência por categoria.</p>
  </section>

  <div class="market-dashboard-container">
    <div class="market-ticker-wrapper">
      <div class="market-ticker-label" data-i18n="quote_ticker_label">Ticker</div>
      <div class="market-ticker-content">
        {tickerItems.length > 0 ? (
          <div class:list={["market-ticker-track", { static: tickerItems.length < 10 }]}>
            <div class="market-ticker-run">
              {tickerItems.map((item) => (
                <span class={`market-tick-chip ${item.direction}`}>
                  <strong class="market-tick-cat" data-i18n={`quote_cat_${item.categoria}`}>{categoryMap[item.categoria] || item.categoria}</strong>
                  <span class="market-tick-name" data-i18n={`quote_label_${slugText(item.label)}`}>{item.label}</span>
                  <span class="market-tick-delta">{formatSignedPercent(item.deltaPct)}</span>
                </span>
              ))}
            </div>
            {tickerItems.length >= 10 && (
              <div class="market-ticker-run" aria-hidden="true">
                {tickerItems.map((item) => (
                  <span class={`market-tick-chip ${item.direction}`}>
                    <strong class="market-tick-cat" data-i18n={`quote_cat_${item.categoria}`}>{categoryMap[item.categoria] || item.categoria}</strong>
                    <span class="market-tick-name" data-i18n={`quote_label_${slugText(item.label)}`}>{item.label}</span>
                    <span class="market-tick-delta">{formatSignedPercent(item.deltaPct)}</span>
                  </span>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="market-ticker-empty" data-i18n="quote_empty_ticker">Sem variações suficientes para montar o ticker neste ciclo.</div>
        )}
      </div>
    </div>

    <div class="terminal-layout">
      <aside class="terminal-sidebar">
        <div class="sidebar-header" data-i18n="quote_sidebar_title">Categorias</div>
        <ul class="asset-list">
          {categoriasOrdenadas.map((prefix, idx) => (
            <li>
              <button class:list={["asset-btn", { active: idx === 0 }]} data-ativo={prefix}>
                <span data-i18n={`quote_cat_${prefix}`}>{categoryMap[prefix] || prefix.toUpperCase()}</span>
                <small>{(datasetPorCategoria[prefix] ?? []).length} <span data-i18n="quote_unit_registros">Registros</span></small>
              </button>
            </li>
          ))}
        </ul>
      </aside>

      <main class="terminal-display">
        <div class="terminal-topbar">
          <div class="update-block">
            <span class="update-label" data-i18n="quote_last_update">Última atualização</span>
            <strong class="update-value update-date-js">{atualizacao}</strong>
          </div>
          <label class="search-wrap">
            <span data-i18n="quote_search_placeholder">Buscar no painel ativo</span>
            <input type="search" id="marketSearch" data-i18n="quote_search_example" placeholder="Ex.: Arábica, Boi, Junho, Var..." />
          </label>
        </div>

        {categoriasOrdenadas.map((prefix, idx) => (
          <div class:list={["quote-panel", { active: idx === 0 }]} data-ativo={prefix}>
            <div class="panel-header">
              <h2 data-i18n={`quote_cat_${prefix}`}>{categoryMap[prefix] || prefix.toUpperCase()}</h2>
              <p data-i18n="quote_panel_desc">Somente ativos compatíveis com a cadeia selecionada.</p>
            </div>

            <div class="boi-cards">
              {(cardsPorCategoria[prefix] ?? []).map((card) => (
                <article class="boi-card">
                  <header class="boi-card-head">
                    <div class="boi-thumb" aria-hidden="true">
                      <i class={`fa-solid ${resolveCardIcon(prefix, card.title, card.subtitle)}`}></i>
                    </div>
                    <div>
                      <h3 data-i18n={`quote_card_title_${slugText(card.title)}`}>{card.title}</h3>
                      <p data-i18n={`quote_card_sub_${slugText(card.subtitle)}`}>{card.subtitle}</p>
                    </div>
                  </header>
                  <div class="static-table-container">
                    <table class="market-table compact">
                      <thead>
                        <tr>
                          {card.columns.map((col) => (
                            <th data-i18n={`quote_th_${slugText(col)}`}>{col}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {card.rows.map((line) => (
                          <tr data-status={line.status || "unknown"} data-busca={line.busca}>
                            {line.cells.map((cell, idx) => (
                              <td class={idx === 0 ? "item-name" : ""}>
                                {idx === 0 ? (
                                  <span data-i18n={`quote_label_${slugText(cell)}`}>{cell}</span>
                                ) : (
                                  // Se a célula for uma data (contém / e tem números)
                                  /\d+\/\d+/.test(cell) ? (
                                    <span class="update-date-js">{cell}</span>
                                  ) : (
                                    cell
                                  )
                                )}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  <footer class="boi-card-foot">
                    <span data-i18n="quote_footer_updated">Atualizado em</span> <span class="update-date-js">{atualizacao}</span>
                  </footer>
                </article>
              ))}
            </div>
          </div>
        ))}
      </main>
    </div>
  </div>
</CotacoesLayout>

<script>
  declare const translations: Record<string, Record<string, string>> | undefined;
  let cotacoesInitialized = false;

  const localeByLang: Record<string, string> = { pt: "pt-BR", en: "en-US", es: "es-ES", cn: "zh-CN" };
  const monthsPtShort = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
  const monthsEnShort = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const monthsEsShort = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
  const monthsPtLong = ["janeiro", "fevereiro", "marco", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"];
  const monthsEnLong = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const monthsEsLong = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];

  function getCurrentLang(): string {
    return document.documentElement.getAttribute("data-preferred-lang") || localStorage.getItem("preferredLang") || "pt";
  }

  function normalizeMonthToken(value: string): string {
    return String(value || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  }

  function translateMonthTokens(raw: string, lang: string): string {
    let out = String(raw || "");
    if (!out || lang === "pt") return out;

    monthsPtShort.forEach((pt, idx) => {
      const escaped = pt.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      if (lang === "en") out = out.replace(new RegExp(`\\b${escaped}\\b`, "gi"), monthsEnShort[idx]);
      if (lang === "es") out = out.replace(new RegExp(`\\b${escaped}\\b`, "gi"), monthsEsShort[idx]);
      if (lang === "cn") out = out.replace(new RegExp(`\\b${escaped}\\b`, "gi"), `${idx + 1}月`);
    });

    monthsPtLong.forEach((pt, idx) => {
      const escaped = pt.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      if (lang === "en") out = out.replace(new RegExp(`\\b${escaped}\\b`, "gi"), monthsEnLong[idx]);
      if (lang === "es") out = out.replace(new RegExp(`\\b${escaped}\\b`, "gi"), monthsEsLong[idx]);
      if (lang === "cn") out = out.replace(new RegExp(`\\b${escaped}\\b`, "gi"), `${idx + 1}月`);
    });

    return out;
  }

  function parsePtLikeDate(raw: string): { day: number; month: number; year: number | null } | null {
    const text = String(raw || "").trim();
    if (!text) return null;

    const m1 = text.match(/^(\d{1,2})[\/.-](\d{1,2})(?:[\/.-](\d{2,4}))?$/);
    if (m1) {
      const day = Number(m1[1]);
      const month = Number(m1[2]);
      let year: number | null = m1[3] ? Number(m1[3]) : null;
      if (year !== null && year < 100) year += 2000;
      if (day >= 1 && day <= 31 && month >= 1 && month <= 12) return { day, month, year };
      return null;
    }

    const normalized = normalizeMonthToken(text);
    const m2 = normalized.match(/^(\d{1,2})\s+de\s+([a-z]+)\s+de\s+(\d{4})$/);
    if (m2) {
      const day = Number(m2[1]);
      const monthName = m2[2];
      const month = monthsPtLong.indexOf(monthName) + 1;
      const year = Number(m2[3]);
      if (day >= 1 && day <= 31 && month >= 1 && month <= 12) return { day, month, year };
      return null;
    }

    return null;
  }

  function formatDateByLang(raw: string, lang: string): string {
    const parsed = parsePtLikeDate(raw);
    if (!parsed) return translateMonthTokens(raw, lang);

    const day = String(parsed.day).padStart(2, "0");
    const month = String(parsed.month).padStart(2, "0");
    if (parsed.year == null) {
      if (lang === "en") return `${month}/${day}`;
      if (lang === "cn") return `${month}/${day}`;
      return `${day}/${month}`;
    }
    const year = String(parsed.year);
    if (lang === "en") return `${month}/${day}/${year}`;
    if (lang === "cn") return `${year}/${month}/${day}`;
    return `${day}/${month}/${year}`;
  }

  function parsePtNumeric(raw: string): { value: number; isPercent: boolean; decimals: number; signed: boolean } | null {
    const text = String(raw || "").trim();
    if (!text || text === "-" || text === "--") return null;

    const isPercent = /%$/.test(text);
    let body = text.replace(/%$/, "").trim();
    const signed = /^[+-]/.test(body);
    body = body.replace(/^[+-]/, "");

    const normalized = body.replace(/\./g, "").replace(",", ".");
    if (!/^\d+(\.\d+)?$/.test(normalized)) return null;
    const value = Number(normalized);
    if (!Number.isFinite(value)) return null;
    const decimals = normalized.includes(".") ? normalized.split(".")[1].length : 0;
    const sign = text.trim().startsWith("-") ? -1 : 1;
    return { value: value * sign, isPercent, decimals, signed };
  }

  function formatNumericByLang(raw: string, lang: string): string {
    const parsed = parsePtNumeric(raw);
    if (!parsed) return translateMonthTokens(raw, lang);

    const locale = localeByLang[lang] || "pt-BR";
    const decimals = Math.min(4, Math.max(0, parsed.decimals));
    const formatted = new Intl.NumberFormat(locale, {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    }).format(parsed.value);

    if (parsed.isPercent) return `${formatted}%`;
    if (parsed.signed && parsed.value > 0) return `+${formatted}`;
    return formatted;
  }

  function hasTranslationForKey(key: string, lang: string): boolean {
    try {
      if (typeof translations === "undefined") return false;
      const pack = translations?.[lang];
      return Boolean(pack && Object.prototype.hasOwnProperty.call(pack, key));
    } catch (_) {
      return false;
    }
  }


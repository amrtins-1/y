---
import LoginLayout from '../../layouts/LoginLayout.astro';
---

<LoginLayout title="Conectando conta - Instituto Amarte">
    <div class="auth-split-container auth-callback-container">
        <div class="auth-form-panel auth-callback-panel">
            <div class="form-content-box auth-callback-box">
                <div class="form-header">
                    <h2>Conectando sua conta</h2>
                    <p id="supabase-callback-status">Estamos concluindo o login com Google. Isso leva só alguns segundos.</p>
                </div>

                <div class="auth-callback-spinner" aria-hidden="true">
                    <i class="fas fa-circle-notch fa-spin"></i>
                </div>

                <a class="btn-auth-outline" href="/login">Voltar para login</a>
            </div>
        </div>
    </div>

    <script>
        function getApiBaseUrl() {
            const raw = document.documentElement.getAttribute('data-api-base-url') || '';
            const value = String(raw || '').trim().replace(/\/$/, '');
            if (!value) {
                return `${window.location.origin}/api`;
            }
            return value.endsWith('/api') ? value : `${value}/api`;
        }

        async function waitForSupabaseAuth(timeoutMs = 4000) {
            const startedAt = Date.now();

            while (Date.now() - startedAt < timeoutMs) {
                if (window.__supabaseAuth) {
                    return window.__supabaseAuth;
                }
                await new Promise((resolve) => setTimeout(resolve, 50));
            }

            return window.__supabaseAuth || null;
        }

        async function runSupabaseCallback() {
            const statusEl = document.getElementById('supabase-callback-status');
            const supabaseAuth = await waitForSupabaseAuth();

            if (!supabaseAuth || !supabaseAuth.isConfigured) {
                if (statusEl) {
                    statusEl.textContent = 'Configure PUBLIC_SUPABASE_URL e PUBLIC_SUPABASE_ANON_KEY antes de testar o login com Google.';
                }
                return;
            }

            try {
                const supabaseSession = await supabaseAuth.finishOAuthFlow();
                const rememberMe = localStorage.getItem(supabaseAuth.storageKey) != null;
                const apiUrl = `${getApiBaseUrl()}/auth-sessions/supabase`;
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        accessToken: supabaseSession?.accessToken || '',
                        rememberMe,
                    }),
                });

                let authSession = null;
                if (response.status !== 204) {
                    authSession = await response.json().catch(() => null);
                }

                if (!response.ok || !authSession?.userId || !authSession?.sessionId) {
                    throw new Error((authSession && authSession.message) || 'Nao foi possivel criar a sessao do site a partir do login Google.');
                }

                authSession.rememberMe = rememberMe;
                const serialized = JSON.stringify(authSession);
                sessionStorage.setItem('authSession', serialized);
                if (rememberMe) {
                    localStorage.setItem('authSession', serialized);
                } else {
                    localStorage.removeItem('authSession');
                }

                if (statusEl) {
                    statusEl.textContent = 'Conta Google conectada. Redirecionando para o painel...';
                }
                window.location.href = '/painel?authProvider=supabase';
            } catch (error) {
                const message = error instanceof Error ? error.message : 'Nao foi possivel concluir o login com Google.';
                if (statusEl) {
                    statusEl.textContent = message;
                }
                if (typeof window.showFeedback === 'function') {
                    window.showFeedback(message, 'error', 'Falha no callback');
                }
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', runSupabaseCallback, { once: true });
        } else {
            runSupabaseCallback();
        }
    </script>
</LoginLayout>
